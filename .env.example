# ─────────────────────────────────────────────────────────────
#  Copy to `.env` (root) and fill in what you have.
#  Everything here is OPTIONAL — the app boots with zero config
#  (local embedded Postgres + offline agent engine + local auth).
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
# Public origin of the API (used for OAuth callbacks)
API_URL=http://localhost:8787
# Comma separated list of allowed web origins (CORS + cookies)
CLIENT_URL=http://localhost:5173
# Secret used to sign access/refresh JWTs (32+ chars in production)
AUTH_SECRET=please-change-me-to-a-long-random-string-32-chars-min
# Access token lifetime / refresh token lifetime
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Set to "none" on localhost (no-HTTPS dev), "lax" is the default
COOKIE_SAMESITE=lax

# ── Database ─────────────────────────────────────────────────
# Leave EMPTY to use the zero-config embedded Postgres (PGlite)
# that persists to ./.data/pgdata — perfect for local dev.
# Paste a Neon connection string to run on real serverless Postgres:
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── OpenRouter (AI agent) ────────────────────────────────────
# Get a free key at https://openrouter.ai/keys
# Without a key the app runs its offline "Nova" heuristic engine
# (still generates full resumes, bullet rewrites, ATS scoring).
OPENROUTER_API_KEY=
# Any model on OpenRouter: openrouter/auto, anthropic/claude-3.5-sonnet,
# openai/gpt-4o-mini, meta-llama/3.3-70b-instruct, google/gemini-2.0-flash-001
OPENROUTER_MODEL=openrouter/auto
# Optional fallback model if the first one errors
OPENROUTER_FALLBACK_MODEL=
# Attribution headers for OpenRouter rankings
APP_NAME=Arbor Resume
APP_URL=http://localhost:5173

# ── OAuth (optional login buttons appear only when configured) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Mail (optional; reset links are logged to console when unset) ─
SMTP_URL=
MAIL_FROM="Arbor Resume <no-reply@arbor.dev>"

# ── Frontend (Vite injects these at build time) ──────────────
VITE_API_URL=/api
VITE_WS_URL=
